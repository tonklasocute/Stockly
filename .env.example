# Copy to .env.local and fill in. Never commit .env.local.

# --- Supabase ---
# Project URL and anon key are safe to expose to the browser (RLS protects the data).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses RLS — never prefix with NEXT_PUBLIC_, never import in a client component.
SUPABASE_SERVICE_ROLE_KEY=

# --- Market data (Phase 2) ---
# Which provider services/market-data resolves to.
MARKET_DATA_PROVIDER=finnhub
MARKET_DATA_API_KEY=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
