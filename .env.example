# Copy to .env.local and fill in. Never commit .env.local.

# --- Supabase (required) ---
# Project URL and anon key are safe to expose to the browser: RLS is what protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses RLS — never prefix with NEXT_PUBLIC_, never import in a client component.
# Unused in phase 1; needed once shared reference data (quote cache) arrives in phase 2.
SUPABASE_SERVICE_ROLE_KEY=

# --- Market data ---
# Phase 1 ships only the mock provider, with fixed prices in services/market-data/mock-provider.ts.
MARKET_DATA_PROVIDER=mock
MARKET_DATA_API_KEY=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
