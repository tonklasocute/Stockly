# Copy to .env.local and fill in. Never commit .env.local — only this file is tracked.
#
# Grouped by concern. Everything that is not prefixed NEXT_PUBLIC_ is server-only and is read
# through lib/env.server.ts, which imports "server-only" so a client import is a build error rather
# than a leak. See docs/PRODUCTION-CHECKLIST.md before deploying.

# =============================================================================
# DATABASE / AUTH  (required)
# =============================================================================
# The project URL and anon key are safe in the browser: row-level security is what protects the
# data, not the secrecy of these two values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. BYPASSES ROW-LEVEL SECURITY — never prefix with NEXT_PUBLIC_, never import in a
# client component. Used in exactly one place: the scheduled job, which reads alerts belonging to
# every user and has no session to act under.
SUPABASE_SERVICE_ROLE_KEY=

# =============================================================================
# MARKET DATA
# =============================================================================
# "mock" needs no key and serves fixed prices, so the app is fully usable without a provider
# account. "twelvedata" uses live prices. Free tier: 8 API credits per minute, 800 per day, and a
# batch quote costs one credit PER SYMBOL — see docs/ARCHITECTURE.md for how caching makes that work.
MARKET_DATA_PROVIDER=mock
# Server-only. Never prefix with NEXT_PUBLIC_ — that would ship your key to every visitor.
MARKET_DATA_API_KEY=
MARKET_DATA_BASE_URL=https://api.twelvedata.com

# Optional: a different provider for SET (Thai) instruments. Defaults to MARKET_DATA_PROVIDER, so a
# deployment that later signs up for a Thai data vendor changes this one variable and nothing else.
# A provider that does not declare a market is never asked for it — see services/market-data/index.ts.
MARKET_DATA_PROVIDER_SET=

# =============================================================================
# EXCHANGE RATES  (phase 9 — needed only for multi-currency portfolios)
# =============================================================================
# Where a portfolio's holdings are translated into its base currency.
#
# Defaults to MARKET_DATA_PROVIDER: they are the same account on the same rate limit, and running
# live prices against mock rates is never what anyone meant. An unrecognised value yields NO rates
# at all rather than fabricated ones — every converted figure then renders "N/A", which is true.
#
# "mock" serves fixed rates (USD/THB 32.45 and a handful of others) so multi-currency portfolios are
# fully usable without an FX account. "twelvedata" uses /exchange_rate with the key above; one credit
# per currency pair per 10-minute cache window, for the whole deployment.
#
# A single-currency portfolio needs none of this: the identity conversion consults no provider.
FX_PROVIDER=

# =============================================================================
# AI  (phase 7 — optional, off by default)
# =============================================================================
# With AI_ENABLED=false every AI route returns a friendly "unavailable" and the rest of Stockly —
# portfolio, market data, watchlist, screener, alerts — works exactly as before.
AI_ENABLED=false
# "mock" needs no key and returns a deterministic grounded answer, so the AI UI and its tests are
# usable without a provider account. "anthropic" uses the Claude API; "openai" speaks the
# OpenAI-compatible chat-completions shape, which also covers local models and gateways.
AI_PROVIDER=mock
# Server-only. NEVER prefix with NEXT_PUBLIC_.
AI_API_KEY=
# Defaults to claude-opus-5 for anthropic. Any model the chosen provider accepts.
AI_MODEL=
# Only used by the openai-compatible adapter (e.g. http://localhost:11434/v1 for a local model).
AI_BASE_URL=
AI_MAX_TOKENS=2000
# Ignored by the anthropic adapter: current Claude models reject sampling parameters. See docs/AI.md.
AI_TEMPERATURE=0.2
# Hard ceiling on one provider call. Keep below your platform's function timeout.
AI_TIMEOUT_MS=25000
# AI requests one user may make per rolling day. Counted in the database, so it holds across
# serverless instances — unlike the in-memory per-minute limiter.
AI_DAILY_LIMIT=25

# =============================================================================
# SCHEDULED JOBS  (alerts, technical snapshots, retention)
# =============================================================================
# Shared secret the scheduled endpoint checks. Generate with: openssl rand -base64 32
# WITHOUT THIS SET, /api/cron/alerts REJECTS EVERY REQUEST — including Vercel's own scheduler.
# An unset secret is never treated as open access.
CRON_SECRET=

# =============================================================================
# NOTIFICATIONS  (Web Push — optional)
# =============================================================================
# Generate a pair with: npx web-push generate-vapid-keys
# The public key is sent to the browser by design; the private key signs pushes and stays server-side.
# Leave both empty to run with in-app notifications only.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A mailto: or https: URL identifying you to the push service, as the Web Push spec requires.
VAPID_SUBJECT=mailto:you@example.com

# =============================================================================
# APP
# =============================================================================
# The canonical origin, used for the sitemap, robots.txt and Open Graph URLs. On Vercel this can be
# left empty: VERCEL_PROJECT_PRODUCTION_URL is used automatically until a custom domain exists.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# debug | info | warn | error. Defaults to info in production, debug elsewhere. Turning this to
# debug in production is a deliberate, temporary act — see docs/PRODUCTION-RUNBOOK.md.
LOG_LEVEL=

# enforce | report-only | off. The Content-Security-Policy is nonce-based and enforced by default.
# Use report-only for one deployment if you have added a script source and want to see violations
# before they become failures. "off" is for debugging only and should never ship.
CSP_MODE=enforce

# =============================================================================
# END-TO-END TESTS  (local only — never point these at production)
# =============================================================================
# An account that already exists in the target database. Without them the journey spec skips itself.
E2E_EMAIL=
E2E_PASSWORD=
# Set to run the specs against an already-deployed environment instead of a local build.
E2E_BASE_URL=
