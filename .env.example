# Copy to .env.local and fill in. Never commit .env.local.

# --- Supabase (required) ---
# Project URL and anon key are safe to expose to the browser: RLS is what protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses RLS — never prefix with NEXT_PUBLIC_, never import in a client component.
# Required for the scheduled alert job, which reads alerts belonging to every user.
SUPABASE_SERVICE_ROLE_KEY=

# --- Market data ---
# "mock" needs no key and serves fixed prices, so the app is fully usable without a provider account.
# "twelvedata" uses live prices. Free tier: 8 API credits per minute, 800 per day, and a batch quote
# costs one credit PER SYMBOL — see docs/ARCHITECTURE.md for how caching keeps that workable.
MARKET_DATA_PROVIDER=mock
# Server-only. Never prefix with NEXT_PUBLIC_ — that would ship your key to every visitor.
MARKET_DATA_API_KEY=
MARKET_DATA_BASE_URL=https://api.twelvedata.com

# --- Alerts (phase 5) ---
# Shared secret the scheduled alert endpoint checks. Generate with: openssl rand -base64 32
# WITHOUT THIS SET, /api/cron/alerts REJECTS EVERY REQUEST — including Vercel's own scheduler.
CRON_SECRET=

# --- Web Push (phase 5, optional) ---
# Generate a pair with: npx web-push generate-vapid-keys
# The public key is sent to the browser by design; the private key signs pushes and must stay server-side.
# Leave both empty to run with in-app notifications only.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A mailto: or https: URL identifying you to the push service, as the Web Push spec requires.
VAPID_SUBJECT=mailto:you@example.com

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
