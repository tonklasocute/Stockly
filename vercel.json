{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/alerts",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/data",
      "schedule": "30 21 * * 1-5"
    },
    {
      "path": "/api/cron/snapshots",
      "schedule": "15 22 * * 1-5"
    }
  ]
}
